{# Auth Overlay - Full-screen authentication iframe #}
<style>
.nav-login{background:none!important;border:none!important;padding:0!important;cursor:pointer!important;font-size:13px!important;font-weight:500!important;color:hsla(0,0%,0%,.5)!important;transition:color .3s ease!important;overflow:visible!important}
.nav-login:hover{color:hsl(0,0%,0%)!important}
.nav-login span{position:relative!important;display:inline-block!important}
.nav-login span::after{content:''!important;position:absolute!important;bottom:-2px!important;left:0!important;width:0!important;height:1px!important;background:hsl(0,0%,0%)!important;transition:width .3s ease!important;display:block!important}
.nav-login:hover span::after{width:100%!important}

/* Backdrop */
.auth-overlay{position:fixed;inset:0;z-index:9999;background:hsla(0,0%,5%,.7);backdrop-filter:blur(24px);-webkit-backdrop-filter:blur(24px);opacity:0;visibility:hidden;transition:opacity .25s ease,visibility .25s ease;display:flex;align-items:center;justify-content:center}
.auth-overlay.active{opacity:1;visibility:visible}

/* Panel - flex column centering */
.auth-overlay-panel{display:flex;flex-direction:column;align-items:center;gap:.5rem;transform:scale(.9) translateY(40px);opacity:0;transition:all .4s cubic-bezier(.22,1,.36,1)}
.auth-overlay.active .auth-overlay-panel{transform:scale(1) translateY(0);opacity:1}

/* Content container - clips iframe */
.auth-overlay-content{position:relative;width:90vw;max-width:420px;height:520px;overflow:hidden;border-radius:.75rem;background:transparent}

/* Iframe - 200% height to hide external page header */
.auth-overlay-iframe{position:absolute;top:0;left:0;right:0;width:100%;height:200%;border:none;border-radius:.75rem;background:transparent}

/* Desktop back button */
.auth-overlay-back-desktop{display:flex;align-items:center;justify-content:center;gap:.5rem;padding:.5rem 1.25rem;font-size:.75rem;font-weight:600;color:hsla(0,0%,100%,.8);background:hsla(0,0%,100%,.1);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);border:1px solid hsla(0,0%,100%,.15);border-radius:9999px;cursor:pointer;transition:all .3s ease;opacity:0;transform:translateY(8px);transition-delay:0s}
.auth-overlay.active .auth-overlay-back-desktop{opacity:1;transform:translateY(0);transition-delay:.15s}
.auth-overlay-back-desktop:hover{background:hsla(0,0%,100%,.2);color:#fff;border-color:hsla(0,0%,100%,.3)}

/* Mobile back button - hidden by default */
.auth-overlay-back-mobile{display:none;align-items:center;justify-content:center;gap:.5rem;padding:.75rem 1.5rem;font-size:.875rem;font-weight:600;color:#fff;background:hsl(0,0%,8%);border:none;border-radius:9999px;cursor:pointer;box-shadow:0 8px 24px rgba(0,0,0,.3);margin-top:.75rem;opacity:0;transform:translateY(8px);transition:all .3s ease;transition-delay:0s}
.auth-overlay.active .auth-overlay-back-mobile{opacity:1;transform:translateY(0);transition-delay:.15s}

/* Mobile overrides - matches React: w-[100vw] h-[80vh] no border-radius */
@media(max-width:640px){
  .auth-overlay-content{border-radius:0;width:100vw;max-width:100%;height:80vh}
  .auth-overlay-iframe{border-radius:0}
  .auth-overlay-back-desktop{display:none!important}
  .auth-overlay-back-mobile{display:flex}
}
</style>

<div class="auth-overlay" id="authOverlay">
    <div class="auth-overlay-panel">
        <div class="auth-overlay-content">
            <iframe id="authOverlayIframe" class="auth-overlay-iframe" title="Authentication"></iframe>
        </div>
        <!-- Desktop back button -->
        <button type="button" class="auth-overlay-back-desktop" id="authOverlayBackDesktop">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14">
                <line x1="18" y1="6" x2="6" y2="18"/>
                <line x1="6" y1="6" x2="18" y2="18"/>
            </svg>
            <span>Back</span>
        </button>
        <!-- Mobile back button -->
        <button type="button" class="auth-overlay-back-mobile" id="authOverlayBackMobile">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
                <line x1="18" y1="6" x2="6" y2="18"/>
                <line x1="6" y1="6" x2="18" y2="18"/>
            </svg>
            <span>Back</span>
        </button>
    </div>
</div>

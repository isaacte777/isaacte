<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>{{ site_config['title'] }}</title>
    <meta name="description" content="{{ site_config['description'] }}">
    <meta name="author" content="{{ site_config['author'] }}">
    <meta name="keywords" content="affiliate marketing, revenue share, CPA, publishers, advertisers, affiliate network">
    <link rel="icon" href="{{ media_server }}assets/img/favicon.png" type="image/png">

    <meta property="og:title" content="{{ site_config['title'] }}">
    <meta property="og:description" content="{{ site_config['description'] }}">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Unione Partners">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ site_config['title'] }}">
    <meta name="twitter:description" content="{{ site_config['description'] }}">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

    {% for file in css_files %}
        <link rel="stylesheet" href="{{ file }}">
    {% endfor %}
</head>
<body>
<div class="page-wrapper">
    {% block header %}{% endblock %}

    <main class="main-content">
        {% block content %}{% endblock %}
    </main>

    {% block footer %}{% endblock %}
</div>

<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<script src="https://unpkg.com/lenis@1.1.18/dist/lenis.min.js"></script>
<script src="{{ media_server }}assets/js/script.js"></script>
<script>
// Fix: Disable Lenis smooth scroll on touch/mobile devices to prevent
// scroll hijacking during CSS animations (fade-in-up, etc.)
(function(){
  var isTouchDevice = 'ontouchstart' in window || navigator.maxTouchPoints > 0;
  if (isTouchDevice && typeof lenis !== 'undefined' && lenis) {
    lenis.destroy();
    lenis = null;
    // Remove lenis classes so native scroll works
    document.documentElement.classList.remove('lenis', 'lenis-smooth');
  }
})();
</script>
<style>
/* Ensure touch scrolling works on all sections during/after animations */
.section, .hero-section, .fade-in-up, .puzzle-container, .dashboard-mockup {
  touch-action: pan-y !important;
  -webkit-overflow-scrolling: touch;
}
</style>
</body>
</html>
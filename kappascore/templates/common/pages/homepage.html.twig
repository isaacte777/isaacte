{% extends 'common/base.html.twig' %}

{% block content %}
    {# Featured Hero Carousel #}
    <section class="mb-16">
        <div class="relative h-[400px] md:h-[500px] rounded-[40px] overflow-hidden shadow-[0_40px_100px_rgba(0,0,0,0.5)]">
            <div id="hero-carousel" class="relative w-full h-full">
                <div class="hero-slide absolute inset-0 transition-opacity duration-1000 opacity-100">
                    <img src="https://images.unsplash.com/photo-1574629810360-7efbbe195018?auto=format&fit=crop&q=80&w=1920&h=1080" class="absolute inset-0 w-full h-full object-cover scale-110">
                    <div class="absolute inset-0 bg-gradient-to-t from-black via-black/20 to-transparent"></div>
                    <div class="absolute inset-0 bg-gradient-to-r from-black/60 via-transparent to-transparent"></div>
                    <div class="absolute inset-0 flex flex-col items-start justify-center p-8 md:p-16">
                        <div class="flex items-center space-x-3 mb-6">
                            <span class="px-3 py-1 rounded-full bg-emerald-500 text-black text-[9px] font-black tracking-widest">LIVE NOW</span>
                            <span class="text-white/60 text-[10px] font-black tracking-widest uppercase">Champions League</span>
                        </div>
                        <h2 class="text-4xl md:text-6xl font-black tracking-tighter mb-8 leading-none">The Stage is Set.<br><span class="text-emerald-500">Real Madrid vs Man City</span></h2>
                        <button class="px-10 py-4 rounded-2xl bg-white text-black text-[11px] font-black tracking-widest hover:bg-emerald-500 transition-all">WATCH ANALYTICS</button>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {# Sports Navigation Bar #}
    <section class="mb-12">
        <div class="flex items-center space-x-3 overflow-x-auto no-scrollbar pb-4">
            <button class="flex items-center space-x-3 px-6 py-3.5 rounded-2xl bg-emerald-500 text-black text-[10px] font-black tracking-widest transition-all">
                <span>⚽</span><span>SOCCER</span>
            </button>
            {% set sports_list = ['ICE HOCKEY', 'BASKETBALL', 'TENNIS', 'VOLLEYBALL', 'TABLE TENNIS', 'BASEBALL', 'CRIQUET', 'HANDBALL'] %}
            {% for sport_name in sports_list %}
                <button class="flex items-center space-x-3 px-6 py-3.5 rounded-2xl bg-white/[0.03] border border-white/5 text-white/40 text-[10px] font-black tracking-widest hover:text-white hover:border-white/20 transition-all">
                    <span>{{ sport_name }}</span>
                </button>
            {% endfor %}
        </div>
    </section>

    <div class="grid grid-cols-1 lg:grid-cols-[300px_1fr] gap-12">
        {# Left Sidebar: Leagues & Countries #}
        <aside class="space-y-10">
            {# Fixed Leagues #}
            <div class="bg-white/[0.02] border border-white/5 rounded-[32px] p-8">
                <h3 class="text-[10px] font-black tracking-[0.3em] text-white/20 uppercase mb-8 flex items-center justify-between">
                    <span>{{ Translate('Fixed leagues') }}</span>
                    <i class="fa fa-thumb-tack"></i>
                </h3>
                <div class="space-y-2">
                    {% for tournament in fixed_leagues %}
                        <a href="/{{ lang }}/tournament/{{ tournament._id }}" class="flex items-center space-x-4 p-3 rounded-xl hover:bg-white/5 transition-all group">
                            <span class="text-xl grayscale group-hover:grayscale-0 transition-all">{{ countryToFlag(tournament.category.name) }}</span>
                            <span class="text-xs font-bold text-white/40 group-hover:text-white transition-colors">{{ tournament.name }}</span>
                        </a>
                    {% endfor %}
                </div>
            </div>

            {# Countries List #}
            <div class="bg-white/[0.02] border border-white/5 rounded-[32px] p-8">
                <h3 class="text-[10px] font-black tracking-[0.3em] text-white/20 uppercase mb-8">{{ Translate('Countries') }}</h3>
                <div class="max-h-[600px] overflow-y-auto custom-scrollbar space-y-1 pr-2">
                    {# In the original template, countries are in 'results' variable #}
                    {% for result in results %}
                        <a href="/{{ lang }}?country={{ result.country }}" class="flex items-center justify-between p-3 rounded-xl hover:bg-white/5 transition-all group">
                            <div class="flex items-center space-x-4">
                                <span class="text-lg">{{ countryToFlag(result.country) }}</span>
                                <span class="text-xs font-bold text-white/40 group-hover:text-white transition-colors">{{ result.country }}</span>
                            </div>
                            <i class="fa fa-chevron-right text-[10px] text-white/5 group-hover:text-white/20 transition-all"></i>
                        </a>
                    {% endfor %}
                </div>
                <a href="/{{ lang }}/countries" class="block w-full mt-6 py-4 text-center text-[9px] font-black tracking-widest text-emerald-500 uppercase hover:text-emerald-400 transition-colors border-t border-white/5">
                    {{ Translate('Show all countries') }}
                </a>
            </div>
        </aside>

        {# Main Content: Events #}
        <section class="space-y-10">
            {# Event Filters #}
            <div class="flex items-center justify-between bg-white/[0.02] border border-white/5 p-2 rounded-2xl">
                <div class="flex items-center space-x-1">
                    <a href="#results" class="px-6 py-3 rounded-xl bg-emerald-500 text-black text-[10px] font-black tracking-widest transition-all">
                        {{ Translate('Results') }}
                    </a>
                    <a href="/{{ lang }}/live-score" class="px-6 py-3 rounded-xl text-white/40 hover:text-white text-[10px] font-black tracking-widest transition-all">
                        {{ Translate('Live') }} <span class="ml-1 text-emerald-500">26</span>
                    </a>
                    <a href="#next-events" class="px-6 py-3 rounded-xl text-white/40 hover:text-white text-[10px] font-black tracking-widest transition-all">
                        {{ Translate('Next events') }}
                    </a>
                </div>
                <div class="pr-4">
                    <i class="fa fa-calendar text-white/20"></i>
                </div>
            </div>

            {# Recommended Events List #}
            <div class="space-y-12">
                <h2 class="text-2xl font-black tracking-tight flex items-center space-x-4">
                    <span class="w-2 h-8 bg-emerald-500 rounded-full"></span>
                    <span>{{ Translate('Recommended Events') }}</span>
                </h2>

                {# The original template uses a flat loop for recommended_events #}
                <div class="bg-white/[0.02] border border-white/5 rounded-[32px] overflow-hidden shadow-2xl">
                    <div class="divide-y divide-white/5">
                        {% for event in recommended_events %}
                            <a href="/{{ lang }}/event/{{ event.int_id }}" class="flex items-center px-8 py-6 hover:bg-white/[0.03] transition-all group">
                                {# Time/Status #}
                                <div class="w-24 flex flex-col items-start">
                                    <span class="text-[10px] font-black text-white/20 group-hover:text-white/40 transition-colors">{{ event.date }}</span>
                                    <span class="text-sm font-mono font-black text-emerald-500">{{ event.time }}</span>
                                </div>

                                {# Teams & Score #}
                                <div class="flex-1 flex items-center justify-between px-12">
                                    <div class="flex-1 text-right pr-8">
                                        <span class="text-sm font-black tracking-tight group-hover:text-emerald-400 transition-colors">
                                            {{ event.home_team.name|default(event.en|split(' - ')|first) }}
                                        </span>
                                    </div>
                                    
                                    <div class="bg-black/40 px-6 py-2 rounded-xl border border-white/5 min-w-[100px] text-center">
                                        <span class="text-xl font-black tracking-tighter tabular-nums">
                                            {{ event.score|default('vs') }}
                                        </span>
                                    </div>

                                    <div class="flex-1 text-left pl-8">
                                        <span class="text-sm font-black tracking-tight group-hover:text-emerald-400 transition-colors">
                                            {{ event.away_team.name|default(event.en|split(' - ')|last) }}
                                        </span>
                                    </div>
                                </div>

                                {# Actions #}
                                <div class="flex items-center space-x-4 opacity-20 group-hover:opacity-100 transition-all">
                                    <div class="p-2 rounded-lg bg-white/5 hover:bg-white/10"><i class="fa fa-television text-xs"></i></div>
                                    <div class="p-2 rounded-lg bg-white/5 hover:bg-white/10"><i class="fa fa-bar-chart text-xs"></i></div>
                                </div>
                            </a>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </section>
    </div>
{% endblock %}

{% extends TemplatePath(template, "base.html.twig") %}

{% block pagetitle %}{% if page_title is defined and page_title is not null %}{{ page_title }}{% else %}{{ Translate('Last results') }}{% endif %}{% endblock %}

{% block header %}
    {% include TemplatePath(template, "parts/header.html.twig") %}
    {% include TemplatePath(template, "parts/subheader.html.twig") with {'parent_page': '/' ~ lang} %}
{% endblock %}

{% block content %}
    <style>
        div#calendar {
            margin-top: 0;
            position: relative;
            background: var(--secundary-bg-color);
            color: var(--primary-font-color);
            padding: 10px;
        }
        .calendar .day {
            width: 16px!important;
            height: 16px!important;
            font-size: 14px!important;
            line-height: normal!important;
            cursor:pointer!important;
        }
        .calendar td {
            font-size: 14px!important;
        }
        .calendar .day.has-event:after {
            background: var(--nav-bg-color) !important;
            width: 14px !important;
            height: 2px !important;
            left: calc(50% - 6.5px)!important;
            border-radius: 0px !important;
        }
        .calendar table {
            margin: 0px!important;
        }

        .tabs-homepage-view,
        .tabs-homepage-filters{
            display: inline-flex;
            vertical-align: top;
            gap: 4px;
            background: var(--third-bg-color);
            border: 1px solid var(--ks-border);
            border-radius: 10px;
            padding: 4px;
        }
        .tabs-homepage-view a,
        .tabs-homepage-filters a {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            line-height: 26px;
            font-size: 12.5px;
            font-weight: 600;
            color: var(--ks-text-secondary);
            border: none;
            text-decoration: none;
            padding: 7px 20px;
            border-radius: 7px;
            transition: all 0.2s ease;
        }
        .tabs-homepage-view a:hover,
        .tabs-homepage-filters a:hover {
            color: #fff;
            background: rgba(255, 255, 255, 0.06);
        }
        .tabs-homepage-view a.active,
        .tabs-homepage-filters a.active {
            background: var(--ks-accent);
            color: #000;
            font-weight: 700;
            box-shadow: 0 2px 12px rgba(34, 197, 94, 0.4);
        }
        .tabs-homepage-view a.active:hover,
        .tabs-homepage-filters a.active:hover {
            background: var(--ks-accent-soft);
            color: #000;
        }
        .tabs-homepage-filters a img {
            height: 12px;
            vertical-align: initial;
        }
        #live-events-btn > span {
            color: var(--ks-accent);
            font-weight: bold;
            display: inline-block;
            margin-left: 5px;
            background: var(--ks-accent-glow);
            padding: 1px 7px;
            border-radius: 999px;
            font-size: 10px;
        }

        #results,
        #next-events {
            max-height: 600px;
            overflow-y: auto;
            scrollbar-width: thin;
            scrollbar-color: rgba(255,255,255,0.1) transparent;
        }
        #results::-webkit-scrollbar,
        #next-events::-webkit-scrollbar {
            width: 4px;
        }
        #results::-webkit-scrollbar-track,
        #next-events::-webkit-scrollbar-track {
            background: transparent;
        }
        #results::-webkit-scrollbar-thumb,
        #next-events::-webkit-scrollbar-thumb {
            background: rgba(255,255,255,0.1);
            border-radius: 4px;
        }
        #results::-webkit-scrollbar-thumb:hover,
        #next-events::-webkit-scrollbar-thumb:hover {
            background: rgba(255,255,255,0.2);
        }

        .league_line_items {
            margin-bottom: 12px;
            border-radius: var(--ks-radius);
            overflow: hidden;
            border: 1px solid var(--ks-border);
            background: var(--third-bg-color);
            transition: border-color 0.2s ease;
        }
        .league_line_items:hover {
            border-color: var(--ks-border-hover);
        }
        .league_line_items_header {
            background: rgba(34, 197, 94, 0.08);
            color: #fff;
            font-size: 11.5px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            line-height: 36px;
            position: relative;
            padding: 0 16px;
            border-bottom: 1px solid var(--ks-border);
        }
        .league_line_items_header img.flagicon {
            position: absolute;
            top: 11px;
            left: 9px;
            height: 14px;
        }
        .league_line_items_events > a {
            text-decoration: none;
        }
        .league_line_items_events .league_line_items_event {
            background: var(--third-bg-color);
            white-space: nowrap;
            padding: 5px 0;
            color: var(--primary-font-color);
            height: auto;
            min-height: 38px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.03);
            transition: background 0.12s ease;
        }
        .league_line_items_events .league_line_items_event:last-child {
            border-bottom: none;
        }
        .league_line_items_events .league_line_items_event:hover {
            background: rgba(34, 197, 94, 0.04);
        }
        .league_line_items_events .league_line_items_event > div {
            display: inline-block;
            vertical-align: top;
            align-items: center;
            align-content: center;
            height: 100%;
        }
        .league_line_items_events .league_line_items_event > .league_line_items_event_opt {
            width: 40px;
            text-align: center;
            color: var(--ks-text-dim);
        }
        .league_line_items_events .league_line_items_event > .league_line_items_event_time {
            width: 80px;
            text-align: center;
            font-size: 12px;
            white-space: normal;
            color: var(--ks-text-secondary);
        }
        .league_line_items_events .league_line_items_event > div.league_line_items_event_name {
            width: calc(100% - 40px - 80px - 50px - 70px);
            font-size: 13px;
            font-weight: 500;
            white-space: nowrap;
            text-overflow: ellipsis;
            overflow: hidden;
        }
        .league_line_items_events .league_line_items_event > div.league_line_items_event_score {
            width: 50px;
            font-size: 13px;
            font-weight: 700;
            text-align: center;
            color: #fff;
        }
        .league_line_items_events .league_line_items_event > div.league_line_items_event_btn {
            width: 53px;
        }
        .league_line_items_events .league_line_items_event > div.league_line_items_event_name a {
            color: var(--primary-font-color);
            text-decoration: none;
            width: 100%;
            display: inline-block;
            transition: color 0.12s ease;
        }
        .league_line_items_events .league_line_items_event:hover > div.league_line_items_event_name a {
            color: #fff;
        }

        .content-homepage-view {
            margin-top: 15px;
        }
        .content-homepage-view > div {
            display: none;
        }
        .content-homepage-view > div.active {
            display: block;
        }
        .league_line_items_events .league_line_items_event > div.league_line_items_event_btn a {
            color: var(--ks-text-dim);
            transition: color 0.12s ease;
        }
        .league_line_items_events .league_line_items_event:hover > div.league_line_items_event_btn a {
            color: var(--ks-accent);
        }

        h2 {
            color: var(--ks-accent);
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1.2px;
            padding-bottom: 10px;
            border-bottom: 1px solid var(--ks-border);
            width: 100%;
        }

        .hp-contents {
            white-space: nowrap;
            min-height: 600px;
            padding: 24px 0 48px;
        }
        .right-container {
            width: calc(100% - 260px);
            display: inline-block;
            vertical-align: top;
            padding-left: 24px;
        }
        .left-bar-container {
            width: 240px;
            display: inline-block;
            vertical-align: top;
            background: var(--third-bg-color);
            border: 1px solid var(--ks-border);
            border-radius: var(--ks-radius);
            padding: 14px;
        }

        ul.list-left-bar-hp {
            list-style: none;
            margin: 0;
            padding: 0;
        }
        ul.list-left-bar-hp li {
            margin-bottom: 1px;
            padding: 0;
        }
        ul.list-left-bar-hp li a i {
            position: absolute;
            right: 10px;
            top: 3px;
            background: transparent;
            display: none;
            color: var(--ks-accent);
        }
        ul.list-left-bar-hp li.selected a i {
            display: block;
        }
        ul.list-left-bar-hp li a {
            position: relative;
            display: flex;
            align-items: center;
            gap: 10px;
            color: var(--ks-text-secondary);
            text-decoration: none;
            font-size: 12.5px;
            font-weight: 500;
            width: 100%;
            padding: 8px 10px;
            border-radius: 6px;
            transition: all 0.12s ease;
        }
        ul.list-left-bar-hp li a:hover {
            background: var(--ks-accent-glow);
            color: var(--ks-accent);
        }
        ul.list-left-bar-hp li img {
            height: 14px;
            position: static;
            flex-shrink: 0;
        }

        .list-left-bar-hp-countries {
            max-height: 400px;
            overflow-y: auto;
            scrollbar-width: thin;
            scrollbar-color: rgba(255,255,255,0.1) transparent;
        }
        .list-left-bar-hp-countries::-webkit-scrollbar {
            width: 4px;
        }
        .list-left-bar-hp-countries::-webkit-scrollbar-track {
            background: transparent;
        }
        .list-left-bar-hp-countries::-webkit-scrollbar-thumb {
            background: rgba(255,255,255,0.1);
            border-radius: 4px;
        }
        .list-left-bar-hp-countries::-webkit-scrollbar-thumb:hover {
            background: rgba(255,255,255,0.2);
        }
        @media only screen and (max-width: 768px) {
            .left-bar-container {
                display: none!important;
            }
            .right-container {
                width: 100%;
                padding-left: 0;
            }
            .tabs-homepage-view, .tabs-homepage-filters {
                margin: 0 5px;
            }
        }
    </style>
    <div class="main-container">

        <div class="hp-contents">

            <div class="left-bar-container">

                {% set fixed_leagues = 0 %}

                {% for sport in sport_menu %}
                    {% if sport._id == sport_selected %}
                        {% for tournament in sport.tournaments %}
                            {% set fixed_leagues = fixed_leagues+1 %}
                        {% endfor %}
                    {% endif %}
                {% endfor %}

                {% if fixed_leagues > 0 %}

                    <h2><i class="fa fa-thumb-tack" aria-hidden="true"></i> {{ Translate('Fixed leagues') }}</h2>

                    <ul class="list-left-bar-hp">
                        {% for sport in sport_menu %}
                            {% if sport._id == sport_selected %}

                                {% for tournament in sport.tournaments %}
                                    <li><a href="/{{ lang }}/tournament/{{ tournament._id }}" data-cid="{{ tournament.oxb_id }}" data-type="tournament">{{ countryToFlag(tournament.category.name) }} {{ tournament.name }}</a></li>
                                {% endfor %}

                            {% endif %}
                        {% endfor %}
                    </ul>

                {% endif %}

                <h2>{{ Translate('Countries') }}</h2>

                <ul class="list-left-bar-hp list-left-bar-hp-countries">
                    {% set unique_countries = [] %}
                    {% set total_countries = 0 %}
                    {% for result in next_events %}
                        {% if result.country not in unique_countries %}
                            {% set unique_countries = unique_countries|merge([result.country]) %}
                            <li class="filter-by-country-btn" data-cid="{{ result.country_id }}" data-country-code="{{ countyToCode(result.country) }}" data-cn="{{ result.country }}">
                                <a href="#" data-type="tournament">
                                    {{ countryToFlag(result.country) }}
                                    {{ result.country }}
                                    <i class="fa fa-window-close-o" aria-hidden="true"></i>
                                </a>
                            </li>
                            {% set total_countries = total_countries+1 %}
                        {% endif %}
                    {% endfor %}
                </ul>

                <div class="ks-ad-wrapper" id="ks-ad-leftbar">
                    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2502506691273037"
                            crossorigin="anonymous"></script>
                    <!-- Leftbar Bottom -->
                    <ins class="adsbygoogle"
                         style="display:block"
                         data-ad-client="ca-pub-2502506691273037"
                         data-ad-slot="3132804372"
                         data-ad-format="auto"
                         data-full-width-responsive="true"></ins>
                    <script>
                      (adsbygoogle = window.adsbygoogle || []).push({});
                    </script>
                </div>

            </div>

            <div class="right-container">

                <div class="ks-ad-wrapper" id="ks-ad-top">
                    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2502506691273037"
                            crossorigin="anonymous"></script>
                    <!-- Banner Top Side -->
                    <ins class="adsbygoogle"
                         style="display:block"
                         data-ad-client="ca-pub-2502506691273037"
                         data-ad-slot="7159679298"
                         data-ad-format="auto"
                         data-full-width-responsive="true"></ins>
                    <script>
                      (adsbygoogle = window.adsbygoogle || []).push({});
                    </script>
                </div>

                {% if favorite_events|length > 0 %}

                    <h2>{{ Translate('Recommended Events') }}</h2>

                    {% for result in favorite_events %}
                        <div class="league_line_items">
                            <div class="league_line_items_header">
                                {{ countryToFlag(result.country) }}
                                {{ result.country|upper }}: {{ result.name }} <i class="fa fa-thumb-tack" aria-hidden="true"></i>
                            </div>
                            <div class="league_line_items_events">
                                {% for event in result.events %}
                                    <div class="league_line_items_event">
                                        <div class="league_line_items_event_opt"><i class="fa fa-star-o" aria-hidden="true"></i></div>
                                        <div class="league_line_items_event_time">{{ jsDate("d/m/Y H:i", event.ste) }}</div>
                                        <div class="league_line_items_event_name"><a href="/{{ lang }}/event/{{ event.int_id }}">{{ event.en|replace({' - ': "<br />"})|raw }}</a></div>
                                        <div class="league_line_items_event_score"></div>
                                        <div class="league_line_items_event_btn">
                                            <a href="#results" class="active" title="{{ Translate('View details') }}"><i class="fa fa-desktop" aria-hidden="true"></i></a>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    {% endfor %}

                {% endif %}

                <div class="tabs-homepage-view" style="margin-bottom: 16px;">
                    <a href="#results" class="active" id="tab-results-btn">{{ Translate('Results') }}</a>
                    <a href="/{{ lang }}/live-score" id="live-events-btn">{{ Translate('Live') }} <span>0</span></a>
                    <a href="#next-events" id="tab-next-btn">{{ Translate('Next events') }}</a>
                </div>

                <div class="tabs-homepage-filters"></div>

                <div class="content-homepage-view">
                    <div class="active" id="results">
                        {% for result in last_results %}
                            <div class="league_line_items" data-cid="{{ result.country_id }}">
                                <div class="league_line_items_header">
                                    {{ countryToFlag(result.country) }}
                                    {{ result.country|upper }}: {{ result.name }}</i>
                                </div>
                                <div class="league_line_items_events">
                                    {% for event in result.events %}
                                        <div class="league_line_items_event">
                                            <div class="league_line_items_event_opt"><i class="fa fa-star-o" aria-hidden="true"></i></div>
                                            <div class="league_line_items_event_time">{{ Translate('Finished') }}</div>
                                            <div class="league_line_items_event_name"><a href="/{{ lang }}/event/{{ event.int_id }}">{{ event.en|replace({' - ': "<br />"})|raw }}</a></div>
                                            <div class="league_line_items_event_score">{{ event.esc|replace({':': "<br />"})|raw }}</div>
                                            <div class="league_line_items_event_btn">
                                                <a href="#results" class="active" title="{{ Translate('View details') }}"><i class="fa fa-info-circle" aria-hidden="true"></i></a>
                                            </div>
                                        </div>
                                    {% endfor %}
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                    <div class="" id="next-events">
                        {% for result in next_events|sort((a, b) => a.ste <=> b.ste) %}
                            <div class="league_line_items" data-cid="{{ result.country_id }}">
                                <div class="league_line_items_header">
                                    {{ countryToFlag(result.country) }}
                                    {{ result.country|upper }}: {{ result.name }}
                                </div>
                                <div class="league_line_items_events">
                                    {% for event in result.events %}
                                        <div class="league_line_items_event">
                                            <div class="league_line_items_event_opt"><i class="fa fa-star-o" aria-hidden="true"></i></div>
                                            <div class="league_line_items_event_time">{{ jsDate("d/m/Y H:i", event.ste) }}</div>
                                            <div class="league_line_items_event_name"><a href="/{{ lang }}/event/{{ event.int_id }}">{{ event.en|replace({' - ': "<br />"})|raw }}</a></div>
                                            <div class="league_line_items_event_score"></div>
                                            <div class="league_line_items_event_btn">
                                                <a href="#results" class="active" title="{{ Translate('View details') }}"><i class="fa fa-desktop" aria-hidden="true"></i></a>
                                            </div>
                                        </div>
                                    {% endfor %}
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>

            </div>
        </div>

    </div>
{% endblock %}

{% block footer %}
    {% include TemplatePath(template, "parts/footer.html.twig") %}
{% endblock %}

{% block scripts %}

    {% include TemplatePath(template, "scripts/shared.html.twig") %}

    <script>

      let countries_selected = [];
      let timerLiveCounter;
      async function updateLiveCounter(){
        let data = await makeRequest({
          resource: '',
          data: JSON.stringify({
            opName: 'GetNrLive'
          })
        });

        if(data.resultCode === 0){
          $('#live-events-btn span').text(data.responseInfo)
        }
      }

      function updateCountriesSelected(){
        $(`.filter-by-country-btn.selected`).removeClass('selected');
        $('.tabs-homepage-filters').empty();
        if(countries_selected.length > 0){
          $('#results > .league_line_items, #next-events .league_line_items').hide();
          for (let item of countries_selected){
            let element = $(`.filter-by-country-btn[data-cid="${item}"]`);
            element.addClass('selected');
            let category_name = element.data('cn');
            let category_code = element.data('country-code');
            $('.tabs-homepage-filters').append(`<a href="#" class="active" data-cid="${item}"><img class="flagicon ct-${category_code}" src="{{ ExternalCustomPath('media/images/flags/4x3/') }}${category_code}.svg" alt="${category_name}"> ${category_name} <i class="fa fa-times" aria-hidden="true"></i></a> `);
            $(`#results > .league_line_items[data-cid="${item}"]`).show();
            $(`#next-events .league_line_items[data-cid="${item}"]`).show();
          }
        }else{
          $('#results > .league_line_items, #next-events .league_line_items').show();
        }
      }

      $(document).ready(function(){

        updateLiveCounter();
        timerLiveCounter = setInterval(updateLiveCounter, 10000);

        $(document).off('click', '.tabs-homepage-view > a');
        $(document).on('click', '.tabs-homepage-view > a', function(e){
          if($(this).attr('href').indexOf('#') !== -1){
            e.preventDefault();
            $('.tabs-homepage-view > a').removeClass('active');
            $(this).addClass('active');
            $('.content-homepage-view > div').removeClass('active');
            $('.content-homepage-view > div' + $(this).attr('href')).addClass('active');
          }
        });

        $(document).off('click', '.tabs-homepage-filters a');
        $(document).on('click', '.tabs-homepage-filters a', function(e){
          e.preventDefault();
          let cid   = $(this).data('cid');
          let newList = [];
          for(let item of countries_selected){
            if(cid !== item) newList.push(item);
          }
          countries_selected = newList;
          updateCountriesSelected();
        });


        $(document).off('click', '.filter-by-country-btn');
        $(document).on('click', '.filter-by-country-btn', function(e){
          e.preventDefault();
          let el    = $(this);
          let cid   = el.data('cid');
          if(countries_selected.indexOf(cid) === -1){
            countries_selected.push(cid);
          }else{
            let newList = [];
            for(let item of countries_selected){
              if(cid !== item) newList.push(item);
            }
            countries_selected = newList;
          }
          updateCountriesSelected();
        });
      });

    </script>

    <script>
      /* ─── AdSense gap fix for Chrome/Edge ─── */
      (function collapseEmptyAds() {
        document.querySelectorAll('.ks-ad-wrapper').forEach(function(wrapper) {
          var ins = wrapper.querySelector('ins.adsbygoogle');
          if (!ins) { wrapper.classList.add('ks-ad-collapsed'); return; }

          // Check immediately
          function check() {
            var status = ins.getAttribute('data-ad-status');
            var hasIframe = ins.querySelector('iframe');
            var iframeH = hasIframe ? hasIframe.offsetHeight : 0;

            if (status === 'unfilled' || (!hasIframe && ins.children.length === 0) || iframeH < 10) {
              wrapper.classList.add('ks-ad-collapsed');
              ins.style.display = 'none';
              ins.style.height = '0';
            } else if (status === 'filled' && iframeH > 10) {
              wrapper.classList.remove('ks-ad-collapsed');
            }
          }

          // Observe attribute changes on the ins element
          var observer = new MutationObserver(check);
          observer.observe(ins, { attributes: true, childList: true, subtree: true });

          // Also check after delays (AdSense loads async)
          setTimeout(check, 500);
          setTimeout(check, 1500);
          setTimeout(check, 3000);
          setTimeout(check, 5000);
        });
      })();
    </script>

{% endblock %}

{% extends 'common/base.html.twig' %}

{% block content %}
    {# Featured Hero Carousel (Aesthetics only, sport-specific images) #}
    <section class="mb-20">
        <div class="relative h-[450px] md:h-[550px] rounded-[48px] overflow-hidden shadow-[0_40px_100px_rgba(0,0,0,0.5)]">
            <div id="hero-carousel" class="relative w-full h-full">
                {# Slide 1 (Soccer) #}
                <div class="hero-slide absolute inset-0 transition-opacity duration-1000 opacity-100">
                    <img src="https://images.unsplash.com/photo-1574629810360-7efbbe195018?auto=format&fit=crop&q=80&w=1920&h=1080" class="absolute inset-0 w-full h-full object-cover scale-110">
                    <div class="absolute inset-0 bg-gradient-to-t from-black via-black/40 to-transparent"></div>
                    <div class="absolute inset-0 bg-gradient-to-r from-black/60 via-transparent to-transparent"></div>
                    <div class="absolute inset-0 flex flex-col items-center justify-center p-6 md:p-12 text-center">
                        <div class="flex items-center space-x-4 mb-8">
                            <div class="flex items-center space-x-2 px-4 py-1.5 rounded-full bg-emerald-500 text-black text-[10px] font-black tracking-[0.2em]">
                                <i class="fa fa-circle animate-pulse text-[8px]"></i>
                                <span>LIVE NOW</span>
                            </div>
                            <span class="text-white/60 text-[10px] md:text-xs font-black tracking-[0.3em] uppercase">UEFA Champions League • Final</span>
                        </div>
                        <div class="flex items-center justify-center space-x-8 md:space-x-32 mb-12">
                            <div class="text-center space-y-4 md:space-y-6">
                                <div class="w-20 h-20 md:w-40 md:h-40 bg-white/5 backdrop-blur-3xl rounded-[32px] md:rounded-[40px] flex items-center justify-center border border-white/10 shadow-[0_20px_50px_rgba(0,0,0,0.3)]">
                                    <span class="text-4xl md:text-7xl">🏰</span>
                                </div>
                                <h3 class="text-lg md:text-3xl font-black tracking-tight">Real Madrid</h3>
                            </div>
                            <div class="flex flex-col items-center">
                                <div class="text-5xl md:text-9xl font-black tracking-tighter tabular-nums flex items-center space-x-3 md:space-x-6">
                                    <span>3</span><span class="text-white/10">:</span><span>2</span>
                                </div>
                                <div class="mt-4 md:mt-6 px-4 md:px-6 py-1.5 md:py-2 rounded-xl md:rounded-2xl bg-white/5 backdrop-blur-xl border border-white/10 text-emerald-500 font-mono text-sm md:text-lg font-black shadow-xl">74'</div>
                            </div>
                            <div class="text-center space-y-4 md:space-y-6">
                                <div class="w-20 h-20 md:w-40 md:h-40 bg-white/5 backdrop-blur-3xl rounded-[32px] md:rounded-[40px] flex items-center justify-center border border-white/10 shadow-[0_20px_50px_rgba(0,0,0,0.3)]">
                                    <span class="text-4xl md:text-7xl">🦅</span>
                                </div>
                                <h3 class="text-lg md:text-3xl font-black tracking-tight">Man City</h3>
                            </div>
                        </div>
                        <div class="flex items-center space-x-4 md:space-x-6">
                            <button class="px-8 md:px-12 py-3 md:py-4 rounded-xl md:rounded-2xl bg-emerald-500 text-black text-[10px] md:text-xs font-black tracking-[0.2em] hover:bg-emerald-400 transition-all shadow-[0_0_40px_rgba(16,185,129,0.4)]">WATCH LIVE</button>
                            <button class="px-8 md:px-12 py-3 md:py-4 rounded-xl md:rounded-2xl bg-white/5 backdrop-blur-xl border border-white/10 text-[10px] md:text-xs font-black tracking-[0.2em] hover:bg-white/10 transition-all">ANALYTICS</button>
                        </div>
                    </div>
                </div>
                {# Slide 2 (Basketball) #}
                <div class="hero-slide absolute inset-0 transition-opacity duration-1000 opacity-0">
                    <img src="https://images.unsplash.com/photo-1504450758481-7338eba7524a?auto=format&fit=crop&q=80&w=1920&h=1080" class="absolute inset-0 w-full h-full object-cover scale-110">
                    <div class="absolute inset-0 bg-gradient-to-t from-black via-black/40 to-transparent"></div>
                    <div class="absolute inset-0 bg-gradient-to-r from-black/60 via-transparent to-transparent"></div>
                    <div class="absolute inset-0 flex flex-col items-center justify-center p-6 md:p-12 text-center">
                        <div class="flex items-center space-x-4 mb-8">
                            <div class="flex items-center space-x-2 px-4 py-1.5 rounded-full bg-emerald-500 text-black text-[10px] font-black tracking-[0.2em]">
                                <i class="fa fa-circle animate-pulse text-[8px]"></i>
                                <span>LIVE NOW</span>
                            </div>
                            <span class="text-white/60 text-[10px] md:text-xs font-black tracking-[0.3em] uppercase">NBA • Regular Season</span>
                        </div>
                        <div class="flex items-center justify-center space-x-8 md:space-x-32 mb-12">
                            <div class="text-center space-y-4 md:space-y-6">
                                <div class="w-20 h-20 md:w-40 md:h-40 bg-white/5 backdrop-blur-3xl rounded-[32px] md:rounded-[40px] flex items-center justify-center border border-white/10 shadow-[0_20px_50px_rgba(0,0,0,0.3)]">
                                    <span class="text-4xl md:text-7xl">🏀</span>
                                </div>
                                <h3 class="text-lg md:text-3xl font-black tracking-tight">LA Lakers</h3>
                            </div>
                            <div class="flex flex-col items-center">
                                <div class="text-5xl md:text-9xl font-black tracking-tighter tabular-nums flex items-center space-x-3 md:space-x-6">
                                    <span>102</span><span class="text-white/10">:</span><span>98</span>
                                </div>
                                <div class="mt-4 md:mt-6 px-4 md:px-6 py-1.5 md:py-2 rounded-xl md:rounded-2xl bg-white/5 backdrop-blur-xl border border-white/10 text-emerald-500 font-mono text-sm md:text-lg font-black shadow-xl">Q4 02:14</div>
                            </div>
                            <div class="text-center space-y-4 md:space-y-6">
                                <div class="w-20 h-20 md:w-40 md:h-40 bg-white/5 backdrop-blur-3xl rounded-[32px] md:rounded-[40px] flex items-center justify-center border border-white/10 shadow-[0_20px_50px_rgba(0,0,0,0.3)]">
                                    <span class="text-4xl md:text-7xl">🌉</span>
                                </div>
                                <h3 class="text-lg md:text-3xl font-black tracking-tight">GS Warriors</h3>
                            </div>
                        </div>
                        <div class="flex items-center space-x-4 md:space-x-6">
                            <button class="px-8 md:px-12 py-3 md:py-4 rounded-xl md:rounded-2xl bg-emerald-500 text-black text-[10px] md:text-xs font-black tracking-[0.2em] hover:bg-emerald-400 transition-all shadow-[0_0_40px_rgba(16,185,129,0.4)]">WATCH LIVE</button>
                            <button class="px-8 md:px-12 py-3 md:py-4 rounded-xl md:rounded-2xl bg-white/5 backdrop-blur-xl border border-white/10 text-[10px] md:text-xs font-black tracking-[0.2em] hover:bg-white/10 transition-all">ANALYTICS</button>
                        </div>
                    </div>
                </div>
            </div>
            {# Indicators #}
            <div class="absolute bottom-10 left-1/2 -translate-x-1/2 flex items-center space-x-3 z-20">
                <button class="hero-indicator w-12 h-1.5 rounded-full bg-emerald-500 transition-all duration-500"></button>
                <button class="hero-indicator w-3 h-1.5 rounded-full bg-white/20 transition-all duration-500"></button>
            </div>
        </div>
    </section>

    <div class="grid grid-cols-1 lg:grid-cols-[1fr_400px] gap-16">
        <div class="space-y-20">
            {# Sports Bar (Aesthetics only) #}
            <section>
                <div class="flex items-center justify-between mb-10">
                    <div class="space-y-1">
                        <h2 class="text-2xl md:text-3xl font-black tracking-tight">{{ Translate('Explore Sports') }}</h2>
                        <p class="text-white/20 text-[10px] font-bold tracking-widest uppercase">{{ Translate('Select your preferred discipline') }}</p>
                    </div>
                </div>
                <div class="flex items-center space-x-4 overflow-x-auto no-scrollbar pb-6">
                    <button class="flex items-center space-x-4 px-8 py-4.5 rounded-[24px] whitespace-nowrap text-[11px] font-black tracking-widest transition-all border bg-emerald-500 border-emerald-500 text-black shadow-[0_20px_40px_rgba(16,185,129,0.25)] scale-105">
                        <span class="text-xl">⚽</span><span>SOCCER</span>
                    </button>
                    <button class="flex items-center space-x-4 px-8 py-4.5 rounded-[24px] whitespace-nowrap text-[11px] font-black tracking-widest transition-all border bg-white/[0.03] border-white/5 text-white/30 hover:border-white/20 hover:text-white">
                        <span class="text-xl">🏀</span><span>BASKETBALL</span>
                    </button>
                    <button class="flex items-center space-x-4 px-8 py-4.5 rounded-[24px] whitespace-nowrap text-[11px] font-black tracking-widest transition-all border bg-white/[0.03] border-white/5 text-white/30 hover:border-white/20 hover:text-white">
                        <span class="text-xl">🎾</span><span>TENNIS</span>
                    </button>
                </div>
            </section>

            {# Recommended Events Bento (Aesthetics only, logic preserved) #}
            <section class="space-y-10">
                <div class="flex items-center justify-between">
                    <div class="flex items-center space-x-6">
                        <div class="relative">
                            <div class="w-3 h-3 rounded-full bg-emerald-500 animate-ping absolute inset-0"></div>
                            <div class="w-3 h-3 rounded-full bg-emerald-500 relative"></div>
                        </div>
                        <h2 class="text-2xl md:text-3xl font-black tracking-tight">{{ Translate('Recommended Events') }}</h2>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    {% for league_group in recommended_events %}
                        {% for event in league_group.events %}
                            <a href="{{ path('homepage', {lang: lang}) }}/event/{{ event.int_id }}" class="bg-white/[0.03] border border-white/5 rounded-[40px] p-8 md:p-10 relative overflow-hidden group cursor-pointer shadow-2xl hover:-translate-y-2 transition-all duration-500 block">
                                <div class="absolute top-0 right-0 p-6 md:p-8">
                                    <i class="fa fa-star text-white/5 group-hover:text-yellow-500 transition-all duration-500"></i>
                                </div>
                                <div class="flex items-center space-x-3 mb-10">
                                    <span class="text-lg">{{ countryToFlag(league_group.league.category.name) }}</span>
                                    <span class="text-[10px] font-black tracking-[0.25em] text-white/20 uppercase">{{ league_group.league.name }}</span>
                                </div>
                                <div class="flex items-center justify-between mb-10">
                                    <div class="flex flex-col items-center space-y-4 flex-1">
                                        <div class="w-16 h-16 md:w-20 md:h-20 bg-white/5 rounded-[24px] md:rounded-[28px] flex items-center justify-center text-2xl md:text-3xl border border-white/10 group-hover:border-emerald-500/40 transition-all duration-500 shadow-xl">
                                            {{ event.home_team.name|first }}
                                        </div>
                                        <span class="text-xs md:text-sm font-black text-center tracking-tight">{{ event.home_team.name }}</span>
                                    </div>
                                    <div class="flex flex-col items-center px-4 md:px-8">
                                        <div class="text-3xl md:text-4xl font-black tracking-tighter tabular-nums mb-3">
                                            {{ event.score|default('vs') }}
                                        </div>
                                        {% if event.status == 'live' %}
                                            <div class="flex items-center space-x-2">
                                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                                                <span class="text-[11px] font-mono text-emerald-500 font-black">{{ event.time }}'</span>
                                            </div>
                                        {% endif %}
                                    </div>
                                    <div class="flex flex-col items-center space-y-4 flex-1">
                                        <div class="w-16 h-16 md:w-20 md:h-20 bg-white/5 rounded-[24px] md:rounded-[28px] flex items-center justify-center text-2xl md:text-3xl border border-white/10 group-hover:border-emerald-500/40 transition-all duration-500 shadow-xl">
                                            {{ event.away_team.name|first }}
                                        </div>
                                        <span class="text-xs md:text-sm font-black text-center tracking-tight">{{ event.away_team.name }}</span>
                                    </div>
                                </div>
                                <div class="pt-8 border-t border-white/5 flex items-center justify-between">
                                    <div class="flex items-center space-x-4">
                                        <div class="p-2.5 rounded-xl bg-white/5 hover:bg-white/10 transition-colors"><i class="fa fa-television text-white/30"></i></div>
                                        <div class="p-2.5 rounded-xl bg-white/5 hover:bg-white/10 transition-colors"><i class="fa fa-bar-chart text-white/30"></i></div>
                                    </div>
                                    <span class="text-[9px] font-black tracking-[0.2em] text-white/10 uppercase">ID: #{{ event.int_id }}</span>
                                </div>
                            </a>
                        {% endfor %}
                    {% endfor %}
                </div>
            </section>
        </div>

        {# Sidebar (Aesthetics only, logic preserved) #}
        <aside class="space-y-12">
            {# Premium Analytics Card #}
            <div class="bg-emerald-500 rounded-[40px] md:rounded-[48px] p-8 md:p-10 text-black relative overflow-hidden group shadow-[0_30px_60px_rgba(16,185,129,0.3)] hover:scale-[1.02] transition-all duration-500">
                <div class="absolute -top-10 -right-10 opacity-10 group-hover:scale-125 transition-transform duration-1000">
                    <i class="fa fa-line-chart text-[240px]"></i>
                </div>
                <div class="relative z-10">
                    <div class="w-12 h-12 bg-black rounded-2xl flex items-center justify-center mb-8 shadow-xl">
                        <i class="fa fa-bolt text-emerald-500 text-2xl"></i>
                    </div>
                    <h3 class="text-2xl md:text-3xl font-black tracking-tight mb-4 leading-tight">Pro Analytics Access</h3>
                    <p class="text-sm font-bold opacity-70 mb-10 leading-relaxed">Unlock deep player insights, heatmaps, and AI-powered match outcomes.</p>
                    <button class="w-full bg-black text-white py-5 rounded-[24px] text-[11px] font-black uppercase tracking-[0.25em] hover:shadow-2xl transition-all">UPGRADE TO PRO</button>
                </div>
            </div>

            {# Top Leagues #}
            <section class="bg-white/[0.02] border border-white/5 rounded-[32px] md:rounded-[40px] p-8 md:p-10 shadow-2xl">
                <div class="flex items-center justify-between mb-10">
                    <h3 class="text-[11px] font-black tracking-[0.3em] text-white/20 uppercase">{{ Translate('Fixed leagues') }}</h3>
                    <i class="fa fa-globe text-white/10"></i>
                </div>
                <div class="space-y-3">
                    {% for tournament in fixed_leagues %}
                        <a href="{{ path('homepage', {lang: lang}) }}/tournament/{{ tournament._id }}" class="w-full flex items-center justify-between p-4 md:p-5 rounded-[20px] md:rounded-[24px] hover:bg-white/[0.04] transition-all group relative overflow-hidden border border-transparent hover:border-white/5">
                            <div class="flex items-center space-x-5 relative z-10">
                                <span class="text-2xl grayscale group-hover:grayscale-0 transition-all duration-500">{{ countryToFlag(tournament.category.name) }}</span>
                                <span class="text-sm font-black text-white/40 group-hover:text-white transition-colors">{{ tournament.name }}</span>
                            </div>
                            <i class="fa fa-chevron-right text-white/5 group-hover:text-white transition-all relative z-10 group-hover:translate-x-1"></i>
                        </a>
                    {% endfor %}
                </div>
            </section>
        </aside>
    </div>

    <script>
        {# Hero Carousel Logic #}
        let currentSlide = 0;
        const slides = document.querySelectorAll('.hero-slide');
        const indicators = document.querySelectorAll('.hero-indicator');
        
        function showSlide(index) {
            slides.forEach((slide, i) => {
                slide.style.opacity = i === index ? '1' : '0';
                slide.style.zIndex = i === index ? '1' : '0';
            });
            indicators.forEach((ind, i) => {
                ind.classList.toggle('bg-emerald-500', i === index);
                ind.classList.toggle('w-12', i === index);
                ind.classList.toggle('bg-white/20', i !== index);
                ind.classList.toggle('w-3', i !== index);
            });
        }

        setInterval(() => {
            currentSlide = (currentSlide + 1) % slides.length;
            showSlide(currentSlide);
        }, 5000);
    </script>
{% endblock %}

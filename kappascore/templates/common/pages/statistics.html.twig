{% extends TemplatePath(template, "base.html.twig") %}

{% block pagetitle %}{{ Translate('Sports statistics center') }}{% endblock %}

{% block header %}
    {% include TemplatePath(template, "parts/header.html.twig") %}
{% endblock %}

{% block content %}

    <div class="main-container">
        <div id="content_sportsmenu">
            <ul>
                {% for sport in sports %}
                    <li class="sportListItem" data-sid="{{ sport.oxb_id }}">
                        <a href="/{{ lang }}/sport/{{ sport._id }}">
                            <svg class="icon"><use xlink:href="/images/sport_icons.svg#sports_{{ sport.oxb_id }}"></use></svg>
                            {{ Translate(sport.name) }}
                        </a>
                    </li>
                {% endfor %}
            </ul>
        </div>
    </div>

{% endblock %}

{% block footer %}
    {% include TemplatePath(template, "parts/footer.html.twig") %}
{% endblock %}

{% block scripts %}

    {% include TemplatePath(template, "scripts/shared.html.twig") %}

    <script>

      async function initPage(){



      }

      initPage();

    </script>

{% endblock %}
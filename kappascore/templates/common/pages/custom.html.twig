{% extends TemplatePath(template, "base.html.twig") %}

{% block pagetitle %}{{ tournament.name }}{% endblock %}

{% block header %}
    {% include TemplatePath(template, "parts/header.html.twig") %}
{% endblock %}

{% block content %}
    <style>
        div#content_tournament {
            background: #1c2125;
        }
        .event-on-list {
            color:var(--main-font-color);
            margin-bottom: 5px;
            padding: 15px;
            cursor: pointer;
        }
        .event-on-list:hover {
            background: #0d1822;
        }
        .event-on-list:last-child {
            margin-bottom: 0px;
        }
        .event-on-list .event-on-list-col {
            display: inline-block;
            vertical-align: top;
            text-decoration: none;
        }
        a.event-on-list-details {
            text-decoration: none;
        }
        .event-on-list .event-on-list-col:nth-child(1) {
            width: 120px;
            border-right:1px solid #2f2f2f;
            font-size: 16px;
            text-align: center;
        }
        .event-on-list .event-on-list-col:nth-child(2) {
            width: calc(100% - 210px);
            border-right:1px solid #2f2f2f;
        }
        .event-on-list .event-on-list-col:nth-child(3) {
            width: 75px;
            text-align: center;
            font-size: 32px;
            align-content: center;
            justify-content: center;
        }
        .event-on-list .event-on-list-col .event-on-list-team {
            position: relative;
        }
        .event-on-list .event-on-list-col .event-on-list-team img {
            height: 16px;
            vertical-align: middle;
        }
        .event-on-list-team-score {
            position: absolute;
            right: 15px;
            top: 0;
        }
        .titleOfTournament {
            color: var(--primary-font-color);
            background: #424d5f;
            padding: 5px 10px;
        }
    </style>
    <div class="mainRow">
        <div class="menuCol">
            {% include TemplatePath(template, "parts/leftbar.html.twig") %}
        </div>
        <div class="contentCol">
            <div class="contentColPage active">
                <div class="contentColTitle">
                    <h5><i class="fa fa-desktop" aria-hidden="true"></i> {{ tournament.name }} </h5>
                </div>
                <div id="content_tournament">

                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block footer %}
    {% include TemplatePath(template, "parts/footer.html.twig") %}
{% endblock %}

{% block scripts %}

    {% include TemplatePath(template, "scripts/shared.html.twig") %}

    <script>

      async function initPage(){



      }

      initPage();

    </script>

{% endblock %}
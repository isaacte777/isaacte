{% extends TemplatePath(template, "base.html.twig") %}

{% block pagetitle %}{{ page.title }}{% endblock %}

{% block header %}
    {% include TemplatePath(template, "parts/header.html.twig") %}
{% endblock %}

{% block content %}

    <style>
        @media (max-width: 640px) {
            .page-content {
                padding: 0 5px;
            }
        }
    </style>

    <div class="main-container">
        <div class="page-content">
            {{ page.content|raw }}
        </div>
    </div>

{% endblock %}

{% block footer %}
    {% include TemplatePath(template, "parts/footer.html.twig") %}
{% endblock %}

{% block scripts %}

    {% include TemplatePath(template, "scripts/shared.html.twig") %}

    <script>

      async function initPage(){



      }

      initPage();

    </script>

{% endblock %}
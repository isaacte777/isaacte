<!DOCTYPE html>
<html lang="{{ lang|default('es') }}">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, user-scalable=no, initial-scale=1" />

    <title>
        {% block pagetitle %}{{ meta_title|default('Homepage') }}{% endblock %} | {{ settings.title }}
    </title>

    {% set _canonical = canonical_url|default(app.request.uri) %}
    <link rel="canonical" href="{{ _canonical }}" />

    {% set _alts = alternate_locales|default([]) %}
    {% for alt in _alts %}
        <link rel="alternate" hreflang="{{ alt.code }}" href="{{ alt.url }}" />
    {% endfor %}
    {% if x_default_url is defined and x_default_url %}
        <link rel="alternate" hreflang="x-default" href="{{ x_default_url }}" />
    {% endif %}

    {# ==== INDEXACIÓN (búsqueda/filtros/paginaciones profundas → noindex opcional) ==== #}
    {% set _indexable = indexable is defined ? indexable : true %}
    {% set _follow = robots_follow is defined ? robots_follow : true %}
    {% if not _indexable %}
        <meta name="robots" content="noindex,{{ _follow ? 'follow' : 'nofollow' }}">
    {% endif %}

    {# ==== META BÁSICAS ==== #}
    {% set _desc = meta_description|default('Live sports statistics, results and historical data.') %}
    <meta name="description" content="{{ _desc }}" />

    {# ==== OPEN GRAPH / TWITTER ==== #}
    {% set _og_url = _canonical %}
    {% set _og_title = (block('pagetitle') is defined ? block('pagetitle') : meta_title|default('Homepage')) ~ ' | ' ~ settings.title %}
    {% set _og_image = og_image|default(null) %}
    {% set og_locale_map = {
        'es':'es_ES','en':'en_US','it':'it_IT','fr':'fr_FR','de':'de_DE','pt':'pt_PT'
    } %}
    <meta property="og:type" content="website" />
    <meta property="og:url" content="{{ _og_url }}" />
    <meta property="og:title" content="{{ _og_title }}" />
    <meta property="og:description" content="{{ _desc }}" />
    {% if _og_image %}
        <meta property="og:image" content="{{ _og_image }}" />
    {% endif %}
    <meta property="og:site_name" content="{{ settings.title }}" />
    <meta property="og:locale" content="{{ og_locale_map[lang|default('es')]|default('es_ES') }}" />

    <meta name="twitter:card" content="{{ _og_image ? 'summary_large_image' : 'summary' }}" />
    <meta name="twitter:title" content="{{ _og_title }}" />
    <meta name="twitter:description" content="{{ _desc }}" />
    {% if _og_image %}
        <meta name="twitter:image" content="{{ _og_image }}" />
    {% endif %}

    <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin>
    <link rel="dns-prefetch" href="//www.googletagmanager.com">
    <link rel="preload" href="/style.css" as="style" />
    <link rel="stylesheet" href="/style.css?v=125">
    <link rel="stylesheet" href="{{ ExternalCustomPath('statistics/fa/css/font-awesome.min.css') }}">
    <link rel="stylesheet" href="{{ ExternalCustomPath('https://cdn.feedh.net/flags/css/flag-icons.min.css') }}">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&family=Noto+Sans:ital,wght@0,100..900;1,100..900&family=Roboto+Condensed:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">

    {% if settings.settings.ga4_tag is defined and settings.settings.ga4_tag != '' %}
        <script async src="https://www.googletagmanager.com/gtag/js?id={{ settings.settings.ga4_tag }}"></script>
        <script>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', '{{ settings.settings.ga4_tag }}');
        </script>
    {% endif %}

    {% block structured_data %}{% endblock %}
</head>
<body class="{{ body_class|default('') }} scroll-minimalista">

{% block header %}{% endblock %}
{% block content %}{% endblock %}
{% block footer %}{% endblock %}

<script src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.30.1/moment.min.js" defer></script>
<script src="/simple-calendar/jquery.simple-calendar.js" defer></script>
<link rel="stylesheet" href="/simple-calendar/simple-calendar.css" />
{% block scripts %}{% endblock %}
<script id="Cookiebot" src="https://consent.cookiebot.com/uc.js" data-cbid="279990a9-7c75-46da-bf77-f30346f89524" data-blockingmode="auto" type="text/javascript"></script>

</body>
</html>
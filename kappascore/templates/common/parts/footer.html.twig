<style>
    .footer {
        position: relative;
        color: var(--primary-font-color);
        background: #0a0a0a;
        margin-top: 56px;
    }
    .footer .footer-top {
        background: #0a0a0a;
        position: relative;
        width: 100%;
        color: var(--primary-font-color);
        padding: 48px 0;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
    }
    .footer .footer-bottom {
        position: relative;
        width: 100%;
        color: #555555;
        padding: 20px 0;
        font-size: 12px;
        font-weight: 500;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
        text-align: center;
    }
    .footer .footer-top .footer-top-brand {
        width: calc(40% - 5px);
        display: inline-block;
        vertical-align: top;
    }
    .footer .footer-top .footer-top-links {
        width: 60%;
        display: inline-block;
    }
    .footer .footer-top .footer-top-links .footer-top-link-list {
        display: inline-block;
        width: calc(50% - 2.5px);
        vertical-align: top;
    }
    .footer .footer-top .footer-top-links .footer-top-link-list h5 {
        font-size: 10.5px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1.2px;
        color: #888888;
        margin-top: 0;
        margin-bottom: 16px;
    }
    .footer .footer-top .footer-top-links .footer-top-link-list ul {
        padding: 0;
        list-style: none;
    }
    .footer .footer-top .footer-top-links .footer-top-link-list ul li {
        padding: 4px 0;
    }
    .footer .footer-top .footer-top-links .footer-top-link-list ul li a {
        color: #555555;
        text-decoration: none;
        font-size: 13px;
        font-weight: 500;
        transition: color 0.12s ease;
    }
    .footer .footer-top .footer-top-links .footer-top-link-list ul li a:hover {
        color: #22c55e;
    }

    .logo-sm {
        display: inline-block;
        font-family: 'Plus Jakarta Sans', sans-serif;
        color: #fff;
        font-weight: 800;
    }

    .logo-sm span {
        color: #22c55e;
        font-weight: 800;
        font-family: 'Plus Jakarta Sans', sans-serif;
    }

    .footer .footer-top .footer-top-brand .logo a {
        display: inline-block;
        font-family: 'Plus Jakarta Sans', sans-serif;
        color: #fff;
        font-weight: 800;
        font-size: 22px;
        text-decoration: none;
        letter-spacing: -0.5px;
    }

    .footer .footer-top .footer-top-brand .logo a span {
        color: #22c55e;
        font-weight: 800;
        font-family: 'Plus Jakarta Sans', sans-serif;
    }

    .footer .footer-top .footer-top-brand .tagline {
        color: #555555;
        font-size: 13px;
        margin-top: 12px;
        line-height: 1.7;
        max-width: 280px;
    }

    /* --- SECCIÓN RESPONSIVE CORREGIDA --- */
    @media only screen and (max-width: 768px) {
        .footer .footer-top .footer-top-brand {
            text-align: center;
            width: 100%;
            display: block;
        }
        
        /* Centrado del texto descriptivo en móvil */
        .footer .footer-top .footer-top-brand .tagline {
            margin-left: auto;
            margin-right: auto;
            text-align: center;
        }

        .footer .footer-top .footer-top-links {
            text-align: center;
            margin-top: 25px;
            width: 100%;
            display: block;
        }
        .footer .footer-top .footer-top-links .footer-top-link-list {
            text-align: center;
            width: 100%;
            margin-bottom: 20px;
        }
        .footer .footer-bottom {
            text-align: center;
        }
    }
</style>

<div class="footer">
    <div class="footer-top">
        <div class="main-container">
            <div class="footer-top-brand">
                <div class="logo"><a href="/">Kappa<span>score</span></a></div>
                <p class="tagline">Live sports statistics, results and historical data.</p>
                {% include "common/parts/markets_rules.html.twig" %}
                <div class="social"></div>
            </div>
            <div class="footer-top-links">
                <div class="footer-top-link-list">
                    <h5>Others</h5>
                    <ul>
                        <li><a href="/{{ lang }}/page/advertising">{{ Translate('Advertising') }}</a></li>
                        <li><a href="/{{ lang }}/page/contact-us">{{ Translate('Contact us') }}</a></li>
                    </ul>
                </div>
                <div class="footer-top-link-list">
                    <h5>{{ Translate('Legal documents') }}</h5>
                    <ul>
                        <li><a href="/{{ lang }}/page/privacy-policy">{{ Translate('Privacy Policy') }}</a></li>
                        <li><a href="/{{ lang }}/page/cookie-policy">{{ Translate('Cookie Policy') }}</a></li>
                        <li><a href="/{{ lang }}/page/tc">{{ Translate('Terms & Conditions') }}</a></li>
                        <li><a href="/{{ lang }}/page/gdpr">{{ Translate('GDPR & Journalism') }}</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
    <div class="footer-bottom">
        <div class="main-container">
            Copyright &copy; {{ Date('Y') }} <div class="logo-sm">Kappa<span>score</span></div> - {{ Translate('All Rights Reserved.') }}
        </div>
    </div>
</div>
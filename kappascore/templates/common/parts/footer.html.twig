<style>
    .footer {
        position: relative;
        color: #fff;
        background: rgb(22 25 55);
    }
    .footer .footer-top {
        background: #0f1126;
        position: relative;
        width: calc(100% - 20px);
        color: #fff;
        padding: 25px 10px;
        border-top: 1px solid rgb(21 32 67);
    }
    .footer .footer-bottom {
        position: relative;
        width: calc(100% - 20px);
        color: var(--primary-font-color);
        padding: 10px 10px;
        font-size: 12px;
    }
    .footer .footer-top .footer-top-brand {
        width: calc(50% - 5px);
        display: inline-block;
        vertical-align: top;
    }
    .footer .footer-top .footer-top-links {
        width: 50%;
        display: inline-block;
    }
    .footer .footer-top .footer-top-links .footer-top-link-list {
        display: inline-block;
        width: calc(50% - 2.5px);
        vertical-align: top;
    }
    .footer .footer-top .footer-top-links .footer-top-link-list h5 {
        font-size: 18px;
        margin-top:0px;
        margin-bottom: 10px;
    }
    .footer .footer-top .footer-top-links .footer-top-link-list ul {
        padding: 0;
        list-style: none;
    }
    .footer .footer-top .footer-top-links .footer-top-link-list ul li {
        padding: 5px 0;
    }
    .footer .footer-top .footer-top-links .footer-top-link-list ul li a {
        color: var(--primary-font-color);
        text-decoration: none;
    }
    @media only screen and (max-width: 768px) {
        .footer .footer-top .footer-top-brand {
            text-align: center;
            width: 100%;
            display: inline-block;
            vertical-align: top;
        }
        .footer .footer-top .footer-top-links {
            text-align: center;
            margin-top:25px;
            width: 100%;
            display: inline-block;
        }
        .footer .footer-top .footer-top-links .footer-top-link-list {
            text-align: center;
            width: 100%;
        }
        .footer .footer-bottom {
            text-align:center;
        }
    }

    .logo-sm {
        display: inline-block;
        font-family: "Noto Sans", sans-serif;
        color: #fff;
        font-weight: 600;
    }

    .logo-sm span {
        color: rgb(230 61 38);
        font-weight: 400;
        font-family: "Noto Sans", sans-serif;
    }
</style>
<div class="footer">

    <div class="footer-top">

        <div class="main-container">
            <div class="footer-top-brand">
                <div class="logo"><a href="/">Kappa<span>score</span></a></div>
                {% include "common/parts/markets_rules.html.twig" %}
                <div class="social"></div>
            </div>
            <div class="footer-top-links">
                <div class="footer-top-link-list">
                    <h5>Others</h5>
                    <ul>
                        <li><a href="/{{ lang }}/page/advertising">{{ Translate('Advertising') }}</a></li>
                        <li><a href="/{{ lang }}/page/contact-us">{{ Translate('Contact us') }}</a></li>
                    </ul>
                </div>
                <div class="footer-top-link-list">
                    <h5>{{ Translate('Legal documents') }}</h5>
                    <ul>
                        <li><a href="/{{ lang }}/page/privacy-policy">{{ Translate('Privacy Policy') }}</a></li>
                        <li><a href="/{{ lang }}/page/cookie-policy">{{ Translate('Cookie Policy') }}</a></li>
                        <li><a href="/{{ lang }}/page/tc">{{ Translate('Terms & Conditions') }}</a></li>
                        <li><a href="/{{ lang }}/page/gdpr">{{ Translate('GDPR & Journalism') }}</a></li>
                    </ul>
                </div>
            </div>
        </div>

    </div>
    <div class="footer-bottom">
        <div class="main-container">
            Copyright &copy; {{ Date('Y') }} <div class="logo-sm">Kappa<span>score</span></div> - {{ Translate('All Rights Reserved.') }}
        </div>
    </div>
</div>
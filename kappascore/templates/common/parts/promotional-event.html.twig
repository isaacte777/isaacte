{% if event_details is not null %}

    <style>
        .bookmakers{
            margin: 18px 0;
            padding: 16px;
            border-radius: 16px;
        }

        .bookmakers__header{
            display:flex;
            align-items:flex-start;
            justify-content:space-between;
            gap: 14px;
            margin-bottom: 14px;
        }

        .bookmakers__title{
            margin: 0;
            font-size: 16px;
            font-weight: 800;
            letter-spacing: .2px;
        }

        .bookmakers__subtitle{
            margin: 6px 0 0;
            font-size: 12px;
            opacity: .8;
            max-width: 640px;
        }

        .bookmakers__disclaimer{
            display:flex;
            flex-direction:column;
            gap: 6px;
            font-size: 11px;
            opacity: .85;
            text-align:right;
        }

        .bookmakers__badge{
            align-self:flex-end;
            font-weight: 900;
            font-size: 10px;
            padding: 6px 10px;
            border-radius: 999px;
            border: 1px solid rgba(255,255,255,.12);
            background: rgba(255,255,255,.06);
        }

        .bookmakers__grid{
            display:grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 12px;
        }

        @media (max-width: 980px){
            .bookmakers__grid{ grid-template-columns: 1fr; }
            .bookmakers__disclaimer{ text-align:left; }
        }

        .bm{
            border: 1px solid rgba(255,255,255,.10);
            background: rgba(0,0,0,.20);
            padding: 14px;
            display:flex;
            flex-direction:column;
            gap: 12px;
        }

        .bm--featured{
            position:relative;
            outline: 1px solid rgba(120,200,255,.35);
        }

        .bm__top{
            display:flex;
            align-items:flex-start;
            justify-content:space-between;
            gap: 10px;
        }

        .bm__brand{
            display:flex;
            gap: 10px;
            min-width:0;
        }

        .bm__logo{
            width: 38px;
            height: 38px;
            border-radius: 12px;
            display:grid;
            place-items:center;
            font-weight: 900;
            border: 1px solid rgba(255,255,255,.12);
            background: rgba(255,255,255,.06);
        }

        .bm__namewrap{ min-width:0; }

        .bm__name{
            font-weight: 900;
            font-size: 14px;
            white-space:nowrap;
            overflow:hidden;
            text-overflow:ellipsis;
        }
        .bm__name img {
            max-width: 100%;
        }
        .bm__logo img {
            max-width: 100%;
        }

        .bm__meta{
            display:flex;
            flex-wrap:wrap;
            gap: 6px;
            margin-top: 6px;
        }

        .bm__pill{
            font-size: 10px;
            padding: 4px 8px;
            border: 1px solid rgba(255,255,255,.10);
            background: rgba(255,255,255,.04);
            opacity: .95;
        }

        .bm__rating{
            font-weight: 900;
            font-size: 12px;
            padding: 6px 10px;
            border-radius: 999px;
            border: 1px solid rgba(255,255,255,.12);
            background: rgba(255,255,255,.06);
            white-space:nowrap;
        }

        .bm__benefits{
            margin: 0;
            padding-left: 18px;
            font-size: 12px;
            opacity: .9;
            display:flex;
            flex-direction:column;
            gap: 6px;
        }

        .bm__bottom{
            display:flex;
            gap: 10px;
            align-items:center;
            margin-top: auto;
        }

        .bm__cta{
            flex:1;
            text-align:center;
            text-decoration:none;
            font-weight: 900;
            padding: 10px 12px;
            border: 1px solid rgba(255,255,255,.14);
            background: linear-gradient(90deg, #fa6507, #8f3d09);
            color: #0b1020;
        }

        .bm__secondary{
            text-decoration:none;
            font-weight: 800;
            font-size: 12px;
            opacity: .85;
            padding: 10px 12px;
            border: 1px solid rgba(255,255,255,.10);
            background: rgba(255,255,255,.04);
            color: inherit;
        }

        .bookmakers__footer{
            margin-top: 12px;
            padding-top: 10px;
            border-top: 1px solid rgba(255,255,255,.08);
        }

        .bookmakers__responsible{
            margin: 0;
            font-size: 11px;
            opacity: .8;
        }
    </style>

    {% if lang == 'us' or lang == 'it' or lang == 'es' or lang == 'de' or lang == 'fr' %}

        <section class="bookmakers" aria-label="{{ Translate('Recommended betting sites') }}">
            <header class="bookmakers__header">
                <div>
                    <h3 class="bookmakers__title">
                        {{ Translate('Recommended sites to bet on this match') }}
                    </h3>
                    <p class="bookmakers__subtitle">
                        {{ Translate('Selection based on availability, mobile experience and market variety.') }}
                    </p>
                </div>

                <div class="bookmakers__disclaimer">
            <span class="bookmakers__badge">
                {{ Translate('Ad') }}
            </span>
                    <span>
                {{ Translate('Some links may be affiliate links.') }}
            </span>
                </div>
            </header>

            <div class="bookmakers__grid">

                <!-- Card 1 -->
                <article class="bm bm--featured">
                    <div class="bm__top">
                        <div class="bm__brand">
                            <div class="bm__logo" aria-hidden="true">
                                <img src="https://feedh.fra1.cdn.digitaloceanspaces.com/brands/casinok/favicon.png" alt="Icon Casinok" />
                            </div>
                            <div class="bm__namewrap">
                                <div class="bm__name">
                                    <img src="https://feedh.fra1.cdn.digitaloceanspaces.com/brands/casinok/casinok.svg" alt="Casinok" />
                                </div>
                                <div class="bm__meta">
                                    <span class="bm__pill">{{ Translate('Top odds') }}</span>
                                    <span class="bm__pill">{{ Translate('Fast withdrawals') }}</span>
                                    <span class="bm__pill">{{ Translate('Crypto') }}</span>
                                </div>
                            </div>
                        </div>
                        <div class="bm__rating" title="{{ Translate('Rating') }}">
                            ★ 4.7
                        </div>
                    </div>

                    <ul class="bm__benefits">
                        <li>{{ Translate('Welcome bonus') }}</li>
                        <li>{{ Translate('Live streaming') }}</li>
                        <li>{{ Translate('Special match markets') }}</li>
                    </ul>

                    <div class="bm__bottom">
                        <a class="bm__cta"
                           href="https://go.casinok.vip/visit/?bta=35306&brand=casinok"
                           target="_blank"
                           rel="nofollow noopener">
                            {{ Translate('Bet now') }}
                        </a>
                        <a class="bm__secondary"
                           href="https://casinok.com/promotions/8669"
                           target="_blank"
                           rel="nofollow noopener">
                            {{ Translate('View terms') }}
                        </a>
                    </div>
                </article>


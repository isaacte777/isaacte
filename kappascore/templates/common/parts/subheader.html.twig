<style>
    html, body {
        width: 100%;
        max-width: 100vw;
        margin: 0;
        padding: 0;
        overflow-x: hidden;
        position: relative;
        box-sizing: border-box;
    }

    *, *:before, *:after {
        box-sizing: inherit;
    }

    .subheader-sports {
        background: #0a0a0a;
        padding: 0;
        overflow: hidden;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        position: sticky;
        top: 50px;
        z-index: 80;
        width: 100%;
    }

    .subheader-sports .main-container {
        position: relative;
        width: 100%;
        max-width: 100%;
        overflow: hidden; 
    }

    .subheader-sports-content {
        display: flex;
        gap: 6px;
        overflow-x: auto;
        padding: 12px 16px;
        scrollbar-width: none;
        -ms-overflow-style: none;
        -webkit-overflow-scrolling: touch;
        width: 100%;
    }

    .subheader-sports-content::-webkit-scrollbar {
        display: none;
    }

    .subheader-sport-item {
        flex-shrink: 0;
        display: inline-flex;
        align-items: center;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 999px;
        background: transparent;
        transition: all 0.2s ease;
    }

    .subheader-sport-item.selected {
        background: #22c55e;
        color: #000;
        border-color: transparent;
        font-weight: 700;
        box-shadow: 0 2px 12px rgba(34, 197, 94, 0.35);
    }

    .subheader-sport-item a {
        color: inherit;
        text-transform: uppercase;
        font-size: 11.5px;
        text-decoration: none;
        font-weight: 600;
        padding: 8px 16px;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        white-space: nowrap;
    }

    .subheader-sport-item svg {
        height: 14px;
        width: 14px;
        fill: currentColor;
    }

    .subheader-sports .right-hover {
        background: linear-gradient(to left, #0a0a0a 0%, transparent 100%);
        position: absolute;
        top: 0;
        bottom: 0;
        right: 0;
        width: 60px;
        pointer-events: none;
        z-index: 2;
    }
</style>

<div class="subheader-sports">
    <div class="main-container">
        <div class="subheader-sports-content scroll-minimalista">
            {% for sport in sports %}
                <div class="subheader-sport-item {% if sport_selected == sport._id %}selected{% endif %}" data-sid="{{ sport.oxb_id }}">
                    <a href="{{ parent_page }}/{{ sport.sport_key }}">
                        <svg class="icon"><use xlink:href="/images/sport_icons.svg#sports_{{ sport.oxb_id }}"></use></svg>
                        {{ Translate(sport.name) }}
                    </a>
                </div>
            {% endfor %}
        </div>
        <div class="right-hover"></div>
    </div>
</div>
<style>
    img.flagicon {
        height: 12px;
        vertical-align: text-top;
        margin-right: 10px;
    }


</style>
<div class="sportlabel">
    <div class="sportlabelElement">
        <ul class="mainSportElement">
            {% for sport in sport_menu %}
                <li class="sportListItem active" {% if sport.tournaments|length == 0 %}style="display: none"{% endif %}>
                    <a href="#!" class="master-item ">
                        <svg class="icon"><use xlink:href="/images/sport_icons.svg#sports_{{ sport.id }}"></use></svg> {{ sport.name}} <i class="fa fa-chevron-down" aria-hidden="true"></i>
                    </a>
                    <ul class="subSportElement">
                        {% for tournament in sport.tournaments %}
                            <li><a href="/{{ lang }}/tournament/{{ tournament._id }}" data-cid="{{ tournament.oxb_id }}" data-type="tournament"><img class="flagicon" src="{{ ExternalCustomPath('media/images/flags/4x3/') ~ countyToCode(tournament.category.name) }}.svg" alt="{{ tournament.category.name }}">{{ tournament.name }}</a></li>
                        {% endfor %}
                    </ul>
                </li>
            {% endfor %}
        </ul>
    </div>
</div>
{% if lang == 'es' %}
    <style>
        .market-es-rules {
            display: block;
            margin-top: 30px;
        }
        .market-es-rules .market-es-rule-juego-seguro {
            display: inline-block;
            height: 30px;
            width: 176px;
            background: url(/images/es/gambling_es_juegoseguro.svg) no-repeat 50% / 176px 30px;
        }
        .market-es-rules .market-es-rule-auto-prohibicion {
            display: inline-block;
            background: url(/images/es/gambling_es_autoprohibicion.svg) no-repeat 50% / 176px 30px;
            height: 30px;
            width: 176px;
        }
        .market-es-rules p {
            margin-top: 5px;
        }
        .market-es-rules p a {
            text-decoration: none;
            color: #fff;
        }
    </style>
    <div class="market-es-rules">
        <a class="market-es-rule-juego-seguro" href="https://www.ordenacionjuego.es/participantes-juego/juego-seguro" target="_blank"></a>
        <a class="market-es-rule-auto-prohibicion" href="https://www.ordenacionjuego.es/participantes-juego/juego-seguro/rgiaj" target="_blank"></a>
        <p><a href="https://www.jugarbien.es/" target="_blank">Juegue con responsabilidad</a></p>
    </div>
{% elseif lang == 'mx' %}

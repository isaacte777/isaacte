<style>
   
    .ks-unified-header {
        position: sticky;
        top: 0;
        z-index: 100;
        background: rgba(0, 0, 0, 0.92);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border-bottom: 1px solid var(--ks-border);
    }

    .ks-unified-header .main-container {
        display: flex;
        align-items: center;
        height: 50px;
        gap: 24px;
    }

    /* Logo */
    .ks-unified-header .ks-logo a {
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 22px;
        text-decoration: none;
        color: #fff;
        font-weight: 800;
        letter-spacing: -0.5px;
        white-space: nowrap;
    }
    .ks-unified-header .ks-logo a span {
        color: var(--ks-accent);
        font-weight: 800;
        font-family: 'Plus Jakarta Sans', sans-serif;
    }

    /* Top links (Sports / Games / Top Lists) */
    .ks-unified-header .ks-toplinks {
        display: flex;
        align-items: center;
        gap: 2px;
        list-style: none;
        margin: 0;
        padding: 0;
    }
    .ks-unified-header .ks-toplinks li {
        display: inline-block;
    }
    .ks-unified-header .ks-toplinks li a {
        font-size: 11px;
        text-transform: uppercase;
        text-decoration: none;
        color: #888888;
        font-weight: 600;
        letter-spacing: 0.8px;
        padding: 6px 12px;
        border-radius: 6px;
        transition: all 0.12s ease;
    }
    .ks-unified-header .ks-toplinks li a:hover {
        color: #fff;
        background: rgba(255, 255, 255, 0.06);
    }
    .ks-unified-header .ks-toplinks li a.active {
        color: #000;
        background: #22c55e;
        border-radius: 999px;
        font-weight: 700;
    }

    /* Nav pills (Results / Statistics / Live Score) */
    .ks-unified-header .ks-nav {
        display: flex;
        align-items: center;
        gap: 2px;
        margin-left: auto;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid var(--ks-border);
        border-radius: 10px;
        padding: 3px;
    }
    .ks-unified-header .ks-nav a {
        text-decoration: none;
        color: var(--ks-text-secondary);
        font-size: 12.5px;
        font-weight: 600;
        padding: 7px 16px;
        border-radius: 7px;
        transition: all var(--ks-transition);
        display: inline-flex;
        align-items: center;
        gap: 7px;
        white-space: nowrap;
    }
    .ks-unified-header .ks-nav a:hover {
        color: #fff;
        background: rgba(255, 255, 255, 0.06);
    }
    .ks-unified-header .ks-nav a.active {
        color: #fff;
        background: #22c55e;
        box-shadow: 0 2px 12px rgba(34, 197, 94, 0.4);
    }
    .ks-unified-header .ks-nav a.active:hover {
        background: #16a34a;
        color: #fff;
    }
    .ks-unified-header .ks-nav a i {
        font-size: 12px;
    }

    /* Lang selector */
    .ks-unified-header .lang-selector {
        position: relative;
        flex-shrink: 0;
    }
    .ks-unified-header .lang-selected {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 6px 12px;
        background: rgba(34, 197, 94, 0.1);
        color: #22c55e;
        border: 1px solid #22c55e;
        border-radius: 8px;
        cursor: pointer;
        font-size: 12px;
        font-weight: 600;
        transition: all 0.2s ease;
    }
    .ks-unified-header .lang-selected:hover {
        background: rgba(255, 255, 255, 0.08);
        border-color: rgba(255, 255, 255, 0.15);
    }
    .ks-unified-header .lang-selected .fi {
        width: 20px;
        height: 15px;
    }
    .ks-unified-header .lang-dropdown {
        position: absolute;
        top: calc(100% + 6px);
        right: 0;
        background: #111111;
        border: 1px solid rgba(255, 255, 255, 0.15);
        border-radius: 8px;
        list-style: none;
        padding: 4px;
        margin: 0;
        display: none;
        z-index: 200;
        min-width: 140px;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6);
    }
    .ks-unified-header .lang-dropdown li {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 8px 12px;
        cursor: pointer;
        color: #888888;
        font-size: 12px;
        font-weight: 500;
        border-radius: 6px;
        transition: all 0.12s ease;
    }
    .ks-unified-header .lang-dropdown li:hover {
        background: rgba(34, 197, 94, 0.1);
        color: #22c55e;
    }
    .ks-unified-header .lang-dropdown .fi {
        width: 20px;
        height: 15px;
    }
    .ks-unified-header .lang-selector:hover .lang-dropdown,
    .ks-unified-header .lang-dropdown.open {
        display: block;
    }

    /* Mobile nav — always visible bar below header on small screens */
    .ks-unified-header .ks-mobile-nav {
        display: none;
        flex-direction: row;
        justify-content: center;
        align-items: center;
        gap: 4px;
        padding: 4px 20px 6px;
        background: rgba(255, 255, 255, 0.03);
        border-top: 1px solid rgba(255, 255, 255, 0.05);
    }
    .ks-unified-header .ks-mobile-nav a {
        flex: 1;
        text-decoration: none;
        color: var(--ks-text-secondary);
        font-size: 11.5px;
        font-weight: 600;
        padding: 8px 10px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        transition: all 0.2s ease;
        background: rgba(255, 255, 255, 0.04);
        white-space: nowrap;
    }
    .ks-unified-header .ks-mobile-nav a:hover {
        color: #fff;
        background: rgba(255, 255, 255, 0.06);
    }
    .ks-unified-header .ks-mobile-nav a.active {
        color: #fff;
        background: #22c55e;
        box-shadow: 0 2px 12px rgba(34, 197, 94, 0.4);
    }

    @media only screen and (max-width: 1024px) {
        .ks-unified-header .ks-toplinks {
            display: none;
        }
    }

    @media only screen and (max-width: 768px) {
        .ks-unified-header .ks-nav {
            display: none;
        }
        .ks-unified-header .ks-mobile-nav {
            display: flex;
        }
        .ks-unified-header .main-container {
            height: auto;
            min-height: 50px;
        }
        .ks-unified-header .lang-selector {
            margin-left: auto;
        }
    }

    /* Hide the mobile-nav container on desktop so it takes no vertical space */
    .ks-unified-header .ks-mobile-nav-container {
        display: none;
    }
    @media only screen and (max-width: 768px) {
        .ks-unified-header .ks-mobile-nav-container {
            display: block;
        }
    }
</style>

<div id="preloader" style="display:none;">
    <div id="loader"></div>
</div>

<div class="ks-unified-header">
    <div class="main-container">
        <div class="ks-logo">
            <a href="/{{ lang }}">Kappa<span>score</span></a>
        </div>

        <ul class="ks-toplinks">
            <li><a class="active" href="https://kappascore.com">{{ Translate('Sports') }}</a></li>
            <li><a href="https://kappaslot.com">{{ Translate('Games') }}</a></li>
            <li><a href="https://kappatop.com">{{ Translate('Top Lists') }}</a></li>
        </ul>

        <nav class="ks-nav">
            <a href="/{{ lang }}" {% if isActiveMenu('/') %}class="active"{% endif %}><i class="fa fa-bars" aria-hidden="true"></i> {{ Translate('Results') }}</a>
            <a href="/{{ lang }}/statistics" {% if isActiveMenu('/statistics') %}class="active"{% endif %}><i class="fa fa-line-chart" aria-hidden="true"></i> {{ Translate('Statistics') }}</a>
            <a href="/{{ lang }}/live-score" {% if isActiveMenu('/live-score') %}class="active"{% endif %}><i class="fa fa-desktop" aria-hidden="true"></i> {{ Translate('Live Score') }}</a>
        </nav>

        <div class="lang-selector">
            <button class="lang-selected" type="button">
                <span class="fi fi-{{ lang }}"></span>
                <span class="lang-label">{{ lang|upper }}</span>
            </button>
            <ul class="lang-dropdown">
                {% for lg in langs|keys %}
                    <li data-lang="{{ lg }}" data-iso="{{ langs[lg] }}">
                        <span class="fi fi-{{ langs[lg]|replace({'en':'us'}) }}"></span>
                        <span>{{ langs[lg]|replace({'en':'us'})|upper }}</span>
                    </li>
                {% endfor %}
            </ul>
        </div>

    </div>

    <div class="main-container ks-mobile-nav-container" style="padding: 0 24px;">
        <nav class="ks-mobile-nav">
            <a href="/{{ lang }}" {% if isActiveMenu('/') %}class="active"{% endif %}><i class="fa fa-bars" aria-hidden="true"></i> {{ Translate('Results') }}</a>
            <a href="/{{ lang }}/statistics" {% if isActiveMenu('/statistics') %}class="active"{% endif %}><i class="fa fa-line-chart" aria-hidden="true"></i> {{ Translate('Statistics') }}</a>
            <a href="/{{ lang }}/live-score" {% if isActiveMenu('/live-score') %}class="active"{% endif %}><i class="fa fa-desktop" aria-hidden="true"></i> {{ Translate('Live Score') }}</a>
        </nav>
    </div>
</div>

<script>
  function setCookie(name, value, days = 365, path = "/") {
    const expires = new Date(Date.now() + days * 24 * 60 * 60 * 1000).toUTCString();
    document.cookie = `${encodeURIComponent(name)}=${encodeURIComponent(value)}; expires=${expires}; path=${path}; SameSite=Lax`;
  }

  // Toggle language dropdown on click (for mobile touch support)
  document.querySelector('.lang-selected').addEventListener('click', function(e) {
    e.stopPropagation();
    document.querySelector('.lang-dropdown').classList.toggle('open');
  });

  // Close dropdown when clicking outside
  document.addEventListener('click', function() {
    document.querySelector('.lang-dropdown').classList.remove('open');
  });

  document.querySelectorAll('.lang-dropdown li').forEach(item => {
    item.addEventListener('click', () => {
      const iso = item.dataset.iso;
      const lang = item.dataset.lang;

      const selected = document.querySelector('.lang-selected');
      selected.innerHTML = `
        <span class="fi fi-${iso}"></span>
        <span class="lang-label">${iso.toUpperCase()}</span>
      `;

      setCookie('lang', lang, 365);

      const path = window.location.pathname;
      const newPath = path.replace(/^\/[a-z]{2}(?=\/|$)/i, `/${iso}`);
      window.location.href = newPath + window.location.search + window.location.hash;
    });
  });
</script>

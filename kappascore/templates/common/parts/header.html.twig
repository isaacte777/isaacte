<header id="main-header" class="fixed top-0 w-full z-50 transition-all duration-700 bg-transparent py-4">
    <div class="max-w-[1600px] mx-auto px-6 md:px-12 h-20 flex items-center justify-between relative">
        
        {# Logo - Left #}
        <a href="{{ path('homepage', {lang: lang}) }}" class="text-2xl md:text-3xl font-black tracking-tighter flex items-center group cursor-pointer z-10">
            Kappa<span class="text-emerald-500 group-hover:text-emerald-400 transition-colors">score</span>
            <div class="ml-2 w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></div>
        </a>
        
        {# Centered Desktop Nav (Aesthetics only, links preserved) #}
        <nav class="hidden lg:flex items-center space-x-2 absolute left-1/2 -translate-x-1/2">
            <a href="https://kappascore.com" class="relative text-[11px] font-black tracking-[0.25em] px-8 py-2.5 rounded-full transition-all group text-white">
                {{ Translate('Sports') }}
                <div class="absolute inset-0 bg-white/5 border border-white/10 rounded-full -z-10"></div>
            </a>
            <a href="https://kappaslot.com" class="relative text-[11px] font-black tracking-[0.25em] px-8 py-2.5 rounded-full transition-all group text-white/30 hover:text-white">
                {{ Translate('Games') }}
            </a>
            <a href="https://kappatop.com" class="relative text-[11px] font-black tracking-[0.25em] px-8 py-2.5 rounded-full transition-all group text-white/30 hover:text-white">
                {{ Translate('Top Lists') }}
            </a>
        </nav>

        {# Right Actions #}
        <div class="flex items-center space-x-4 md:space-x-8 z-10">
            <div class="hidden xl:flex items-center space-x-3 bg-white/[0.03] border border-white/10 rounded-full px-6 py-2 group focus-within:border-emerald-500/50 transition-all">
                <i class="fa fa-search text-white/20 group-focus-within:text-emerald-500 transition-colors"></i>
                <input type="text" placeholder="Search matches..." class="bg-transparent border-none text-[11px] font-bold focus:outline-none w-40 placeholder:text-white/10">
            </div>

            <div class="flex items-center space-x-2 md:space-x-4">
                {# Language Selector Dropdown (Aesthetics only) #}
                <div class="relative group/lang">
                    <button class="flex items-center space-x-2 bg-[#0a0a0a] border border-white/60 px-3 md:px-4 py-1.5 md:py-2 rounded-xl hover:bg-white/5 transition-all">
                        <span class="text-base md:text-lg">{{ countryToFlag(lang|replace({'en':'us'})) }}</span>
                        <span class="text-[10px] md:text-[11px] font-black tracking-widest text-emerald-500">{{ lang|replace({'en':'us'})|upper }}</span>
                    </button>
                    
                    <div class="absolute right-0 mt-2 w-32 bg-[#0a0a0a] border border-white/10 rounded-2xl overflow-hidden shadow-2xl z-50 opacity-0 invisible group-hover/lang:opacity-100 group-hover/lang:visible transition-all duration-300 translate-y-2 group-hover/lang:translate-y-0">
                        <div class="py-2">
                            {% for lg, url in alternate_locales %}
                                <a href="{{ url }}" class="w-full flex items-center space-x-4 px-4 py-3 hover:bg-white/5 transition-all group">
                                    <span class="text-lg">{{ countryToFlag(lg|replace({'en':'us'})) }}</span>
                                    <span class="text-[11px] font-black tracking-widest text-white/40 group-hover:text-white">{{ lg|replace({'en':'us'})|upper }}</span>
                                </a>
                            {% endfor %}
                        </div>
                    </div>
                </div>

                <button id="mobile-menu-toggle" class="lg:hidden p-3 rounded-xl bg-white/5 border border-white/10">
                    <i class="fa fa-bars"></i>
                </button>
            </div>
        </div>
    </div>

    {# Mobile Navigation (Aesthetics only) #}
    <div id="mobile-menu" class="hidden lg:hidden px-4 pb-6 space-y-4 overflow-hidden">
        <div class="grid grid-cols-3 gap-2">
            <a href="https://kappascore.com" class="text-[10px] font-black tracking-widest py-3 rounded-full transition-all text-center bg-[#10b981] text-black shadow-[0_0_15px_rgba(16,185,129,0.2)]">{{ Translate('Sports') }}</a>
            <a href="https://kappaslot.com" class="text-[10px] font-black tracking-widest py-3 rounded-full transition-all text-center bg-[#0a0a0a] border border-white/5 text-white/60">{{ Translate('Games') }}</a>
            <a href="https://kappatop.com" class="text-[10px] font-black tracking-widest py-3 rounded-full transition-all text-center bg-[#0a0a0a] border border-white/5 text-white/60">{{ Translate('Top Lists') }}</a>
        </div>

        <div class="grid grid-cols-3 gap-1 bg-[#0a0a0a] p-1 rounded-xl border border-white/5">
            <a href="{{ path('homepage', {lang: lang}) }}" class="flex flex-col items-center justify-center py-3 rounded-lg text-[9px] font-black uppercase tracking-widest text-white/40 hover:text-white transition-colors">
                <i class="fa fa-th-large mb-1"></i>
                <span>{{ Translate('Results') }}</span>
            </a>
            <a href="{{ path('homepage', {lang: lang}) }}/statistics" class="flex flex-col items-center justify-center py-3 rounded-lg text-[9px] font-black uppercase tracking-widest text-white/40 hover:text-white transition-colors">
                <i class="fa fa-bar-chart mb-1"></i>
                <span>{{ Translate('Statistics') }}</span>
            </a>
            <a href="{{ path('homepage', {lang: lang}) }}/live-score" class="flex flex-col items-center justify-center py-3 rounded-lg text-[9px] font-black uppercase tracking-widest text-white/40 hover:text-white transition-colors">
                <i class="fa fa-television mb-1"></i>
                <span>{{ Translate('Live Score') }}</span>
            </a>
        </div>
    </div>
</header>

<script>
    window.addEventListener('scroll', function() {
        const header = document.getElementById('main-header');
        if (window.scrollY > 20) {
            header.classList.add('bg-black/80', 'backdrop-blur-2xl', 'border-b', 'border-white/5');
            header.classList.remove('bg-transparent');
        } else {
            header.classList.remove('bg-black/80', 'backdrop-blur-2xl', 'border-b', 'border-white/5');
            header.classList.add('bg-transparent');
        }
    });

    document.getElementById('mobile-menu-toggle').addEventListener('click', function() {
        const menu = document.getElementById('mobile-menu');
        menu.classList.toggle('hidden');
    });
</script>

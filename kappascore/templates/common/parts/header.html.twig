<style>
    .tophead {
        background: rgb(22 25 55);
    }
    .tophead ul.toplinks {
        list-style: none;
        margin: 0px;
        padding: 0px;
    }
    .tophead ul.toplinks > li {
        display: inline-block;
        margin-right: 10px;
        padding: 5px 0;
    }
    .tophead ul.toplinks > li a {
        font-size: 12px;
        text-transform: uppercase;
        text-decoration: none;
        color: #fff;
    }
    .tophead ul.toplinks > li a.active {
        color: rgb(230 61 38);
        font-weight: bold;
    }

    .lang-selector {
        position: relative;
        display: inline-block;
        font-family: inherit;
    }
    li.lang-selector {
        float: right;
        z-index: 9999;
        padding: 0!important;
    }

    .lang-selected {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 5px 10px;
        background: #111;
        color: #fff;
        border: 1px solid rgb(21 32 67);
        cursor: pointer;
    }

    .lang-selected .fi {
        width: 20px;
        height: 15px;
    }

    .lang-dropdown {
        position: absolute;
        top: 100%;
        left: 0;
        background: #111;
        /*transform: translate(-40%);*/
        border: 1px solid rgb(21 32 67);
        list-style: none;
        padding: 4px 0;
        margin: 0;
        display: none;
        z-index: 10;
    }

    .lang-dropdown li {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 6px 10px;
        cursor: pointer;
        color: #fff;
    }

    .lang-dropdown li:hover {
        background: #1e1e1e;
    }

    .lang-dropdown .fi {
        width: 20px;
        height: 15px;
    }

    .lang-selector:hover .lang-dropdown {
        display: block;
    }

    @media only screen and (max-width: 768px) {
        .tophead ul.toplinks {
            text-align: center;
        }
        li.lang-selector {
            float: unset;
            z-index: 9999;
        }
    }

</style>
<div id="preloader" style="display:none;">
    <div id="loader"></div>
</div>
<div class="tophead">
    <div class="main-container">
        <ul class="toplinks">
            <li><a class="active" href="https://kappascore.com">{{ Translate('Sports') }}</a></li>
            <li><a href="https://kappaslot.com">{{ Translate('Games') }}</a></li>
            <li><a href="https://kappatop.com">{{ Translate('Top Lists') }}</a></li>
            <li class="lang-selector">
                <button class="lang-selected" type="button">
                    <span class="fi fi-{{ lang }}"></span>
                    <span class="lang-label">{{ lang|upper }}</span>
                </button>

                <ul class="lang-dropdown">
                    {% for lg in langs|keys %}
                        <li data-lang="{{ lg }}" data-iso="{{ langs[lg] }}">
                            <span class="fi fi-{{ langs[lg]|replace({'en':'us'}) }}"></span>
                            <span>{{ langs[lg]|replace({'en':'us'})|upper }}</span>
                        </li>
                    {% endfor %}
                </ul>
            </li>
        </ul>
    </div>
</div>
<div class="header">
    <div class="main-container">
        <div class="logo">
            <a href="/{{ lang }}">Kappa<span>score</span></a>
        </div>
        <div class="right">

        </div>
    </div>
</div>
<div class="subhead">
    <div class="main-container">
        <a href="/{{ lang }}" {% if isActiveMenu('/') %}class="active"{% endif %}><i class="fa fa-bars" aria-hidden="true"></i> {{ Translate('Results') }}</a> |
        <a href="/{{ lang }}/statistics" {% if isActiveMenu('/statistics') %}class="active"{% endif %}><i class="fa fa-line-chart" aria-hidden="true"></i> {{ Translate('Statistics') }}</a> |
        <a href="/{{ lang }}/live-score" {% if isActiveMenu('/live-score') %}class="active"{% endif %}><i class="fa fa-desktop" aria-hidden="true"></i> {{ Translate('Live Score') }}</a>
    </div>
</div>

<script>
  function setCookie(name, value, days = 365, path = "/") {
    const expires = new Date(Date.now() + days * 24 * 60 * 60 * 1000).toUTCString();
    document.cookie = `${encodeURIComponent(name)}=${encodeURIComponent(value)}; expires=${expires}; path=${path}; SameSite=Lax`;
  }

  document.querySelectorAll('.lang-dropdown li').forEach(item => {
    item.addEventListener('click', () => {
      const iso = item.dataset.iso;   // es / fr / de / us
      const lang = item.dataset.lang; // es_ES / fr_FR / de_DE

      const selected = document.querySelector('.lang-selected');
      selected.innerHTML = `
        <span class="fi fi-${iso}"></span>
        <span class="lang-label">${iso.toUpperCase()}</span>
      `;

      setCookie('lang', lang, 365);

      const path = window.location.pathname;

      const newPath = path.replace(/^\/[a-z]{2}(?=\/|$)/i, `/${iso}`);

      window.location.href = newPath + window.location.search + window.location.hash;
    });
  });
</script>

